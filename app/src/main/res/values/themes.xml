<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JunctionPlus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorAccent">@color/jp_teal</item>
    </style>

    <!-- Splash screen: play sign on black, then the app -->
    <style name="Theme.JunctionPlus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JunctionPlus</item>
    </style>
</resources>
