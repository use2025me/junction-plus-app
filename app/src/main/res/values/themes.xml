<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JunctionPlus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorAccent">@color/jp_teal</item>
    </style>

    <!-- Splash screen: play sign on black, then the branded loading screen -->
    <style name="Theme.JunctionPlus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JunctionPlus</item>
    </style>

    <!-- Update pop-up: dark rounded card, teal buttons -->
    <style name="Theme.JunctionPlus.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/jp_teal</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#FFC8D0D0</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/JunctionPlus.DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/JunctionPlus.DialogButton</item>
    </style>

    <style name="JunctionPlus.DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#FFAAB4B4</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="JunctionPlus.DialogButton.Positive">
        <item name="android:textColor">@color/jp_teal</item>
    </style>
</resources>
