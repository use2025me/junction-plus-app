<?xml version="1.0" encoding="utf-8"?>
<!-- Junction Plus play sign: two rings joined by four ticks, with a rounded play triangle -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer ring -->
    <path
        android:pathData="M54,28 a26,26 0 1,1 0,52 a26,26 0 1,1 0,-52"
        android:strokeColor="#009B8E"
        android:strokeWidth="2.8"
        android:fillColor="#00000000" />
    <!-- inner ring -->
    <path
        android:pathData="M54,34 a20,20 0 1,1 0,40 a20,20 0 1,1 0,-40"
        android:strokeColor="#009B8E"
        android:strokeWidth="2.8"
        android:fillColor="#00000000" />
    <!-- ticks: top, bottom, left, right -->
    <path
        android:pathData="M54,28 L54,34 M54,74 L54,80 M28,54 L34,54 M74,54 L80,54"
        android:strokeColor="#009B8E"
        android:strokeWidth="2.8" />
    <!-- play triangle -->
    <path
        android:pathData="M47.6,44 L47.6,64 L64.6,54 Z"
        android:strokeColor="#009B8E"
        android:strokeWidth="2.8"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
