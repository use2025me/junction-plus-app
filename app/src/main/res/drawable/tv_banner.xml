<?xml version="1.0" encoding="utf-8"?>
<!-- TV home-screen tile (320 x 180): logo on a dark teal glow, with a teal-to-yellow line -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#FF12403C"
                android:centerColor="#FF06110F"
                android:endColor="#FF000000" />
        </shape>
    </item>
    <item
        android:width="210dp"
        android:height="91dp"
        android:gravity="center"
        android:bottom="28dp"
        android:drawable="@drawable/logo_full" />
    <item
        android:width="120dp"
        android:height="3dp"
        android:gravity="center_horizontal|bottom"
        android:bottom="30dp"
        android:drawable="@drawable/brand_line" />
</layer-list>
